<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.openclaw.qa-analyzer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>set -a; source "$HOME/.qa-analyzer.env"; set +a; exec "$HOME/clawd/victig-legal/qa-analyzer/.venv/bin/streamlit" run "$HOME/clawd/victig-legal/qa-analyzer/app.py"</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/clawd/victig-legal/qa-analyzer</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/qa-analyzer.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/qa-analyzer.err.log</string>
</dict>
</plist>
