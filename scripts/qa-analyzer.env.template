# Environment file for the QA Analyzer LaunchAgent.
#
# Copy to ~/.qa-analyzer.env and fill in real values.
# NEVER commit the real values to git.

# Anthropic API key (parser)
ANTHROPIC_API_KEY=sk-ant-...

# Shared token that gates access. Any user without this in ?token=... on
# the URL (or entered on the login screen) is denied.
# Generate with: openssl rand -hex 32
QA_ANALYZER_TOKEN=

# Model override (optional; defaults to claude-haiku-4-5)
# QA_ANALYZER_MODEL=claude-haiku-4-5
